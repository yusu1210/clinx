{
  "name": "clinx",
  "version": "0.2.0-dev.0",
  "description": "AI-native full-stack engineering: a methodology, portable skill, and optional CLI for agent-led, verified software delivery.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusu1210/clinx.git"
  },
  "homepage": "https://github.com/yusu1210/clinx#readme",
  "bugs": {
    "url": "https://github.com/yusu1210/clinx/issues"
  },
  "keywords": [
    "ai-native",
    "software-engineering",
    "agent-skills",
    "cli",
    "verification"
  ],
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "clinx": "bin/clinx.mjs"
  },
  "exports": {
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "bin",
    "dist/cli.js",
    "dist/evidence.js",
    "dist/files.js",
    "dist/inspect.js",
    "dist/junit.js",
    "dist/task.js",
    "dist/install.js",
    "dist/runner.js",
    "dist/schema.js",
    "dist/verify.js",
    "dist/version.js",
    "dist/workspace.js",
    "dist/cli.js.map",
    "dist/evidence.js.map",
    "dist/files.js.map",
    "dist/inspect.js.map",
    "dist/junit.js.map",
    "dist/task.js.map",
    "dist/install.js.map",
    "dist/runner.js.map",
    "dist/schema.js.map",
    "dist/verify.js.map",
    "dist/version.js.map",
    "dist/workspace.js.map",
    "src",
    "schemas",
    "templates",
    "skills",
    "docs",
    "evals",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md",
    "SECURITY.zh-CN.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/schemas.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/*.js' --test-coverage-include='bin/*.mjs' test/*.test.mjs",
    "test:maven": "npm run build && node scripts/test-maven.mjs",
    "test:example:http": "node --test examples/reading-list/test/http.test.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && node scripts/check-project.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
