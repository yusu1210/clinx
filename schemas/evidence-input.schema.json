{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "obligations": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
      }
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "observer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "method": {
      "type": "string",
      "enum": [
        "manual",
        "tool"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        }
      },
      "required": [
        "identity",
        "revision"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "artifacts": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          }
        },
        "required": [
          "path",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "default": [],
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384,
        "pattern": "\\S"
      }
    }
  },
  "required": [
    "obligations",
    "observedAt",
    "observer",
    "method",
    "target",
    "outcome",
    "summary",
    "artifacts"
  ],
  "additionalProperties": false
}
