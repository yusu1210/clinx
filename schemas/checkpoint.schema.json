{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
    },
    "definitionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taskDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "note": {
      "type": "object",
      "properties": {
        "focus": {
          "type": "string",
          "enum": [
            "discover",
            "contract",
            "build",
            "verify",
            "learn"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "blocked",
            "handoff"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "next": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "blockers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          }
        },
        "loop": {
          "type": "object",
          "properties": {
            "iteration": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "hypothesis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "pattern": "\\S"
            },
            "mechanism": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "pattern": "\\S"
            },
            "treatment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "pattern": "\\S"
            },
            "plannedChecks": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "\\S"
              }
            },
            "observations": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "\\S"
              }
            },
            "unknowns": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "\\S"
              }
            },
            "nextAction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "pattern": "\\S"
            },
            "stopReason": {
              "default": "continue",
              "type": "string",
              "enum": [
                "continue",
                "fixed",
                "no-new-high-value-issue",
                "budget-exhausted",
                "needs-review",
                "blocked"
              ]
            }
          },
          "required": [
            "iteration",
            "hypothesis",
            "mechanism",
            "treatment",
            "nextAction"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "focus",
        "state",
        "summary",
        "next"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "sequence",
    "createdAt",
    "taskId",
    "definitionDigest",
    "taskDigest",
    "sources",
    "note"
  ],
  "additionalProperties": false
}
