{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "focus": {
      "type": "string",
      "enum": [
        "discover",
        "contract",
        "build",
        "verify",
        "learn"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "handoff"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "next": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "blockers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384,
        "pattern": "\\S"
      }
    },
    "loop": {
      "type": "object",
      "properties": {
        "iteration": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "treatment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "plannedChecks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          }
        },
        "observations": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          }
        },
        "unknowns": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          }
        },
        "nextAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "stopReason": {
          "default": "continue",
          "type": "string",
          "enum": [
            "continue",
            "fixed",
            "no-new-high-value-issue",
            "budget-exhausted",
            "needs-review",
            "blocked"
          ]
        }
      },
      "required": [
        "iteration",
        "hypothesis",
        "mechanism",
        "treatment",
        "nextAction"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "focus",
    "state",
    "summary",
    "next"
  ],
  "additionalProperties": false
}
