{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
    },
    "context": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "when": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "always",
                "discover",
                "contract",
                "build",
                "verify",
                "learn"
              ]
            }
          }
        },
        "required": [
          "path",
          "description",
          "when"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "inputs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "pattern": "\\S"
            }
          },
          "exclude": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "path",
          "inputs"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "command": {
            "minItems": 1,
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 16384
            }
          },
          "cwd": {
            "default": ".",
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "timeoutMs": {
            "default": 120000,
            "type": "integer",
            "minimum": 50,
            "maximum": 3600000
          },
          "sideEffects": {
            "default": "local",
            "type": "string",
            "enum": [
              "local",
              "external"
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "const": "exit-code"
                  }
                },
                "required": [
                  "format"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "const": "junit"
                  },
                  "from": {
                    "type": "string",
                    "enum": [
                      "stdout",
                      "files"
                    ]
                  },
                  "paths": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384,
                      "pattern": "\\S"
                    }
                  },
                  "minTests": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "expectedTests": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384,
                      "pattern": "\\S"
                    }
                  }
                },
                "required": [
                  "format",
                  "from"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "source",
          "description",
          "command",
          "result"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "name",
    "sources"
  ],
  "additionalProperties": false
}
