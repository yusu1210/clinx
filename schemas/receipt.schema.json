{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "clinxVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "trust": {
      "type": "string",
      "const": "local-execution-not-attested"
    },
    "configDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taskDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        }
      },
      "required": [
        "node",
        "platform",
        "arch"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
          },
          "before": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "after": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "files": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "before",
          "after",
          "files"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
          },
          "execution": {
            "type": "string",
            "enum": [
              "completed",
              "failed-to-run",
              "timed-out",
              "interrupted",
              "unknown"
            ]
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "signal": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "observation": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ]
          },
          "reason": {
            "type": "string"
          },
          "outputTruncated": {
            "type": "boolean"
          },
          "summary": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "passed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "skipped": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "total",
                  "passed",
                  "failed",
                  "skipped"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "execution",
          "exitCode",
          "signal",
          "durationMs",
          "observation",
          "reason",
          "outputTruncated",
          "summary",
          "artifacts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "clinxVersion",
    "runId",
    "startedAt",
    "finishedAt",
    "trust",
    "configDigest",
    "taskDigest",
    "claim",
    "runtime",
    "sources",
    "checks"
  ],
  "additionalProperties": false
}
