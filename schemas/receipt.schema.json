{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "protocolVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "clinxVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "trust": {
      "type": "string",
      "const": "local-execution-not-attested"
    },
    "definitionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "definition": {
      "type": "object",
      "properties": {
        "sources": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "\\S"
              },
              "inputs": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384,
                  "pattern": "\\S"
                }
              },
              "exclude": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "id",
              "path",
              "inputs"
            ],
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
              },
              "source": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "\\S"
              },
              "command": {
                "minItems": 1,
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 16384
                }
              },
              "cwd": {
                "default": ".",
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "pattern": "\\S"
              },
              "timeoutMs": {
                "default": 120000,
                "type": "integer",
                "minimum": 50,
                "maximum": 3600000
              },
              "sideEffects": {
                "default": "local",
                "type": "string",
                "enum": [
                  "local",
                  "external"
                ]
              },
              "result": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "format": {
                        "type": "string",
                        "const": "exit-code"
                      }
                    },
                    "required": [
                      "format"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "format": {
                        "type": "string",
                        "const": "junit"
                      },
                      "from": {
                        "type": "string",
                        "enum": [
                          "stdout",
                          "files"
                        ]
                      },
                      "paths": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384,
                          "pattern": "\\S"
                        }
                      },
                      "minTests": {
                        "default": 1,
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "expectedTests": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384,
                          "pattern": "\\S"
                        }
                      }
                    },
                    "required": [
                      "format",
                      "from"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "source",
              "description",
              "command",
              "result"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources",
        "checks"
      ],
      "additionalProperties": false
    },
    "taskDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S"
        }
      },
      "required": [
        "node",
        "platform",
        "arch"
      ],
      "additionalProperties": false
    },
    "sources": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
          },
          "before": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "after": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "files": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "before",
          "after",
          "files"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
          },
          "execution": {
            "type": "string",
            "enum": [
              "completed",
              "failed-to-run",
              "timed-out",
              "interrupted",
              "unknown"
            ]
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "signal": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "observation": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ]
          },
          "reason": {
            "type": "string"
          },
          "outputTruncated": {
            "type": "boolean"
          },
          "summary": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "passed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "skipped": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "total",
                  "passed",
                  "failed",
                  "skipped"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "execution",
          "exitCode",
          "signal",
          "durationMs",
          "observation",
          "reason",
          "outputTruncated",
          "summary",
          "artifacts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "protocolVersion",
    "clinxVersion",
    "runId",
    "startedAt",
    "finishedAt",
    "trust",
    "definitionDigest",
    "definition",
    "taskDigest",
    "claim",
    "runtime",
    "sources",
    "checks"
  ],
  "additionalProperties": false
}
